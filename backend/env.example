# Copy this file to .env (note the dot) and fill in your keys. Never commit .env.
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional. Model names change often; check Google AI Studio / the Gemini docs for current ones.
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_EMBED_MODEL=gemini-embedding-001
# GEMINI_EMBED_DIM=768
# GROQ_MODEL=llama-3.3-70b-versatile
# Where your markdown knowledge folder is. Relative paths count from this backend folder.
# KB_DIR=../knowledge
