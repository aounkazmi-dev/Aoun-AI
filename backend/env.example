# Copy to the repository root as .env. Never put keys in the frontend.
GEMINI_API_KEY=
GROQ_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_MODEL=openai/gpt-oss-120b
# auto prefers Groq when configured; Gemini remains required for embeddings.
PRIMARY_PROVIDER=auto
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_EMBED_DIM=768

# Offline preview is explicit. False requires a real key and ingested index.
DEMO_MODE=false
# Relative paths are resolved from backend/.
KB_DIR=../knowledge
CHROMA_DIR=chroma_db
# Provisional cosine distance cutoff: calibrate with evaluation, not a probability.
RETRIEVAL_MAX_DISTANCE=0.65
REQUEST_TIMEOUT_SECONDS=30
RATE_LIMIT_PER_MINUTE=12
MAX_CONCURRENT_REQUESTS=4
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
